{
  "name": "mini-hub-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Legacy static Mini Hub plus the staged hybrid SvelteKit, Hono, Tauri rewrite.",
  "packageManager": "pnpm@11.0.7",
  "scripts": {
    "legacy:check": "node scripts/check-all.js",
    "legacy:test": "node scripts/check-all.js",
    "check": "node scripts/check-all.js",
    "test": "node scripts/check-all.js",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "build": "pnpm -r --if-present build",
    "test:workspaces": "pnpm -r --if-present test",
    "dev:hub": "pnpm --filter @mini-hub/hub dev",
    "hub:start:lan": "powershell -ExecutionPolicy Bypass -File scripts/hub-lan.ps1",
    "stack:start:lan": "powershell -ExecutionPolicy Bypass -File scripts/stack-lan.ps1",
    "bridge:start": "powershell -ExecutionPolicy Bypass -File scripts/mini-hub-bridge.ps1 start -Profile local",
    "bridge:start:lan": "powershell -ExecutionPolicy Bypass -File scripts/mini-hub-bridge.ps1 start -Profile lan -HubUi",
    "bridge:stop": "powershell -ExecutionPolicy Bypass -File scripts/mini-hub-bridge.ps1 stop",
    "bridge:restart": "powershell -ExecutionPolicy Bypass -File scripts/mini-hub-bridge.ps1 restart -Profile local",
    "bridge:restart:lan": "powershell -ExecutionPolicy Bypass -File scripts/mini-hub-bridge.ps1 restart -Profile lan -HubUi",
    "bridge:status": "powershell -ExecutionPolicy Bypass -File scripts/mini-hub-bridge.ps1 status",
    "bridge:startup:install": "powershell -ExecutionPolicy Bypass -File scripts/mini-hub-startup.ps1 install",
    "bridge:startup:install:lan": "powershell -ExecutionPolicy Bypass -File scripts/mini-hub-startup.ps1 install -Profile lan -HubUi",
    "bridge:startup:status": "powershell -ExecutionPolicy Bypass -File scripts/mini-hub-startup.ps1 status",
    "bridge:startup:run": "powershell -ExecutionPolicy Bypass -File scripts/mini-hub-startup.ps1 run-now",
    "bridge:startup:run:lan": "powershell -ExecutionPolicy Bypass -File scripts/mini-hub-startup.ps1 run-now -Profile lan -HubUi",
    "bridge:startup:remove": "powershell -ExecutionPolicy Bypass -File scripts/mini-hub-startup.ps1 remove",
    "dev:api": "pnpm --filter @mini-hub/api dev",
    "api:start:lan": "powershell -ExecutionPolicy Bypass -File scripts/hub-api-lan.ps1",
    "dev:desktop": "pnpm --filter @mini-hub/desktop dev",
    "ai-os:start": "powershell -ExecutionPolicy Bypass -File scripts/ai-os.ps1 start",
    "ai-os:start:lan": "powershell -ExecutionPolicy Bypass -File scripts/ai-os.ps1 start -Lan",
    "ai-os:stop": "powershell -ExecutionPolicy Bypass -File scripts/ai-os.ps1 stop",
    "ai-os:status": "powershell -ExecutionPolicy Bypass -File scripts/ai-os.ps1 status",
    "ai-os:backup": "powershell -ExecutionPolicy Bypass -File scripts/ai-os.ps1 backup",
    "ai-os:audit": "powershell -ExecutionPolicy Bypass -File scripts/ai-os-deps.ps1 audit",
    "ai-os:autostart:install": "powershell -ExecutionPolicy Bypass -File scripts/ai-os-autostart.ps1 install -StartNow",
    "ai-os:autostart:status": "powershell -ExecutionPolicy Bypass -File scripts/ai-os-autostart.ps1 status",
    "ai-os:autostart:uninstall": "powershell -ExecutionPolicy Bypass -File scripts/ai-os-autostart.ps1 uninstall",
    "macro-lab:start": "powershell -ExecutionPolicy Bypass -File scripts/macro-lab.ps1 start",
    "macro-lab:start:lan": "powershell -ExecutionPolicy Bypass -File scripts/macro-lab.ps1 start -Lan",
    "macro-lab:stop": "powershell -ExecutionPolicy Bypass -File scripts/macro-lab.ps1 stop",
    "macro-lab:status": "powershell -ExecutionPolicy Bypass -File scripts/macro-lab.ps1 status",
    "check:js": "node scripts/check-js-syntax.js",
    "check:pwa": "node scripts/check-pwa-cache.js",
    "check:poses": "node scripts/pose-shot.js --check",
    "check:logminer": "node scripts/check-logminer.js",
    "qa:hub:smoke": "node scripts/hub-usability-smoke.mjs",
    "qa:hub:smoke:local": "node scripts/hub-usability-smoke.mjs --url http://127.0.0.1:5173",
    "qa:hub:smoke:hosted": "node scripts/hub-usability-smoke.mjs --url https://elc9939.github.io/testing/",
    "qa:hub:usability": "pnpm qa:hub:smoke && pnpm qa:hub:smoke:hosted && pnpm qa:hub:hydrated",
    "qa:hub:hydrated": "node scripts/hub-hydrated-smoke.mjs",
    "qa:hub:hydrated:ai": "node scripts/hub-hydrated-smoke-full-ai.mjs",
    "qa:hub:hydrated:writes": "node scripts/hub-hydrated-smoke-desk-writes.mjs",
    "pose:shot": "node scripts/pose-shot.js",
    "icons": "node scripts/gen-icons.js",
    "task": "node scripts/task.js",
    "ai:connect4:train": "node scripts/train-connect4.js",
    "ai:connect4:eval": "node scripts/eval-connect4.js"
  },
  "devDependencies": {
    "pnpm": "11.0.7"
  }
}
