# Shared
NODE_ENV=development
PUBLIC_API_URL=http://127.0.0.1:8787
PUBLIC_AI_OS_API_URL=http://127.0.0.1:8791
PUBLIC_MACRO_LAB_API_URL=http://127.0.0.1:8792
PUBLIC_SYNC_MODE=personal
TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:1420,http://127.0.0.1:1420

# Hono API / Better Auth
PORT=8787
DATABASE_URL=postgres://mini_hub:mini_hub@localhost:5432/mini_hub
BETTER_AUTH_URL=http://127.0.0.1:8787
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
MINI_HUB_DEV_AUTH_BYPASS=false
MINI_HUB_SYNC_KEY=replace-with-a-private-personal-sync-key
MINI_HUB_TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
HUB_PUBLIC_URL=http://127.0.0.1:5173

# Productivity hub provider OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/api/integrations/google/oauth/callback
BRIGHTSPACE_BASE_URL=
BRIGHTSPACE_CLIENT_ID=
BRIGHTSPACE_CLIENT_SECRET=
BRIGHTSPACE_ICAL_URL=

# Personal AI OS / local-first AI substrate
AI_OS_HOST=127.0.0.1
AI_OS_PORT=8791
AI_OS_DATA_DIR=.ai-os-data
AI_OS_BACKUP_DIR=.ai-os-data/backups
AI_OS_BACKUP_ENABLED=true
AI_OS_BACKUP_INTERVAL_MINUTES=1440
AI_OS_BACKUP_RETENTION_COUNT=14
AI_OS_LOG_DIR=.ai-os-data/logs
AI_OS_LOG_LEVEL=INFO
AI_OS_LOG_RETENTION_DAYS=14
AI_OS_LOG_MAX_BYTES=5000000
AI_OS_TEMP_DIR=.ai-os-data/tmp
AI_OS_ASSETS_DIR=.ai-os-data/assets
AI_OS_REQUIRE_LOOPBACK=true
AI_OS_MAX_REQUEST_BYTES=15000000
AI_OS_MAX_PROMPT_CHARS=200000
AI_OS_MAX_MEMORY_INGEST_CHARS=2000000
AI_OS_MAX_JOB_ITEMS=500
AI_OS_MAX_ACTIVE_JOBS=20
AI_OS_JOB_TIMEOUT_S=1800
AI_OS_CLEANUP_MAX_AGE_DAYS=14
AI_OS_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:1420,http://127.0.0.1:1420
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=all-minilm
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
AI_OS_PROVIDER_PRIORITY=ollama,openai,anthropic
AI_OS_PROVIDER_COSTS_JSON={"ollama":{"input_per_1m":0,"output_per_1m":0},"openai":{"input_per_1m":0,"output_per_1m":0},"anthropic":{"input_per_1m":0,"output_per_1m":0}}
AI_OS_SPECIALIST_PROVIDERS_JSON=[]
AI_OS_HUB_API_URL=http://127.0.0.1:8787
AI_OS_HUB_WORKSPACE_ID=personal
AI_OS_MACRO_LAB_API_URL=http://127.0.0.1:8792
AI_OS_DESIGN_WORKSPACE_ROOT=../..
AI_OS_DESIGN_PATCHES_DIR=.ai-os-data/design-patches
AI_OS_DESIGN_APPLY_ENABLED=true
AI_OS_DESIGN_ALLOWED_EXTENSIONS=.svelte,.ts,.js,.css,.md,.py,.json,.html,.toml,.yml,.yaml
COMFYUI_BASE_URL=
COMFYUI_WORKFLOW_PATH=
COMFYUI_TIMEOUT_S=600
PIPER_EXECUTABLE=
PIPER_VOICE_PATH=
PIPER_TIMEOUT_S=180
WHISPER_EXECUTABLE=
WHISPER_MODEL=base
WHISPER_TIMEOUT_S=600

# Macro Lab / local desktop automation daemon
MACRO_LAB_HOST=127.0.0.1
MACRO_LAB_PORT=8792
MACRO_LAB_DATA_DIR=.macro-lab-data
MACRO_LAB_LOG_LEVEL=INFO
MACRO_LAB_REQUIRE_LOOPBACK=true
MACRO_LAB_MAX_REQUEST_BYTES=10000000
MACRO_LAB_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:1420,http://127.0.0.1:1420
MACRO_LAB_PANIC_HOTKEY=<ctrl>+<alt>+<pause>
MACRO_LAB_CLIPBOARD_POLL_INTERVAL_S=1
MACRO_LAB_TRIGGER_POLL_INTERVAL_S=1
MACRO_LAB_MAX_CLIPBOARD_HISTORY=100
MACRO_LAB_MAX_RUN_HISTORY=500
MACRO_LAB_OLLAMA_MODEL=llama3.2
MACRO_LAB_OLLAMA_TIMEOUT_S=120

# Local/offline client database
PUBLIC_PGLITE_DATA_DIR=idb://mini-hub

# Deployment targets
NEON_DATABASE_URL=
RENDER_EXTERNAL_URL=
RAILWAY_PUBLIC_DOMAIN=
