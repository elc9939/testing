{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main-window permissions for import, export, and local model-cache operations.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    "fs:allow-app-cache-read",
    "fs:allow-app-cache-write",
    "fs:allow-document-read",
    "fs:allow-document-write",
    "fs:allow-download-read",
    "fs:allow-download-write"
  ]
}

